---
import type { Project } from "../data/projects";

interface Props {
    project: Project;
}

const { project } = Astro.props;
const initials = project.name
    .split(" ")
    .map((word: string) => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

const hasImage = Boolean(project.image);
---

<article class="project-card">
    <div
        class={`project-shot ${project.tone} ${hasImage ? "has-image" : ""}`}
    >
        {
            hasImage ? (
                <img
                    src={project.image}
                    alt={`Homepage screenshot for ${project.name}`}
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <span>{initials}</span>
            )
        }
    </div>
    <div class="project-copy">
        <div class="project-heading">
            <h3>{project.name}</h3>
            <span
                class={`status-badge ${project.status === "In Development" ? "status-dev" : "status-live"}`}
            >
                {project.status}
            </span>
        </div>

        <p class="project-category">{project.category}</p>
        <p>{project.description}</p>

        {
            project.technologies.length > 0 && (
                <ul class="chip-list" aria-label={`${project.name} technologies`}>
                    {project.technologies.map((technology) => <li>{technology}</li>)}
                </ul>
            )
        }

        {
            <div class="project-links">
                <a class="text-link" href={`/work/${project.slug}`}>
                    Explore project <span aria-hidden="true">↗</span>
                </a>
                {project.website && (
                    <a
                        class="text-link project-external-link"
                        href={project.website}
                        target="_blank"
                        rel="noreferrer"
                    >
                        Visit live site <span aria-hidden="true">↗</span>
                    </a>
                )}
            </div>
        }
    </div>
</article>

<script>
    const cards = document.querySelectorAll<HTMLElement>(".project-card");
    const supportsScrollHighlight = window.matchMedia(
        "(max-width: 47.99rem) and (prefers-reduced-motion: no-preference)",
    );

    if ("IntersectionObserver" in window && supportsScrollHighlight.matches) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    entry.target.classList.toggle(
                        "is-in-view",
                        entry.isIntersecting,
                    );
                });
            },
            { rootMargin: "-10% 0px -10% 0px", threshold: 0.18 },
        );

        cards.forEach((card) => observer.observe(card));
    }
</script>
