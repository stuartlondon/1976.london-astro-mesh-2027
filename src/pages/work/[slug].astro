---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
const relatedProjects = projects.filter((item) => item.slug !== project.slug).slice(0, 2);
---

<MainLayout
    title={`${project.name} | Work | 1976 London`}
    description={project.description}
    currentPath="/work"
>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/work">Work</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{project.name}</span>
    </nav>

    <article class="case-study">
        <header class="case-study-hero">
            <div class="case-study-heading">
                <span class="eyebrow"><span class="eyebrow-dot"></span> {project.category}</span>
                <h1>
                    {project.caseStudy.headline}
                    {" "}
                    <span>{project.caseStudy.highlight}</span>
                </h1>
                <p>{project.description}</p>
                <div class="case-study-meta">
                    <span>{project.status}</span>
                    <span>{project.technologies.join(" · ")}</span>
                </div>
                <div class="button-row">
                    {project.website && (
                        <a
                            class="button button-primary"
                            href={project.website}
                            target="_blank"
                            rel="noreferrer"
                        >
                            Visit live site <span aria-hidden="true">↗</span>
                        </a>
                    )}
                    <a class="button button-secondary" href="/contact">Discuss a similar project</a>
                </div>
            </div>
            {
                project.image && (
                    <figure class={`case-study-image ${project.tone}`}>
                        <img
                            src={project.image}
                            alt={`Homepage screenshot for ${project.name}`}
                            loading="eager"
                            decoding="async"
                        />
                    </figure>
                )
            }
        </header>

        <section class="case-study-details">
            <div>
                <span class="eyebrow">Project focus</span>
                <h2>{project.caseStudy.focus}</h2>
            </div>
            <div class="case-study-priorities">
                <h3>What mattered</h3>
                <ul>
                    {project.caseStudy.priorities.map((priority) => <li>{priority}</li>)}
                </ul>
            </div>
        </section>
    </article>

    <section class="related-work">
        <div class="section-head section-head-row">
            <div>
                <span class="eyebrow"><span class="eyebrow-dot"></span> More work</span>
                <h2>Another good story.</h2>
            </div>
            <a class="text-link" href="/work">All projects <span aria-hidden="true">↗</span></a>
        </div>
        <div class="projects-grid">
            {relatedProjects.map((relatedProject) => <ProjectCard project={relatedProject} />)}
        </div>
    </section>
</MainLayout>
